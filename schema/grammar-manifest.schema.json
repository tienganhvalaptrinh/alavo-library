{
  "$id": "grammar-manifest.schema.json",
  "allOf": [{ "$ref": "common.schema.json#/$defs/packHeader" }],
  "type": "object",
  "additionalProperties": false,
  "required": ["lessonCount", "lessons"],
  "properties": {
    "id": {},
    "type": { "const": "grammar" },
    "title": {},
    "description": {},
    "category": {},
    "level": {},
    "order": {},
    "sourceLang": {},
    "targetLang": {},
    "version": {},
    "license": {},
    "source": {},
    "coverUrl": {},
    "relatedPacks": {},
    "lessonCount": { "type": "integer", "minimum": 1 },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "level", "path", "sha256"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/slug" },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "level": { "$ref": "common.schema.json#/$defs/cefrLevel" },
          "path": { "type": "string", "pattern": "^[a-z0-9-]+/lesson\\.md$" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "exercises": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "count", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^[a-z0-9-]+/exercises\\.json$" },
              "count": { "type": "integer", "minimum": 1 },
              "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
            }
          }
        }
      }
    }
  }
}
