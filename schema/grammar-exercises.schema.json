{
  "$id": "grammar-exercises.schema.json",
  "type": "array",
  "minItems": 1,
  "maxItems": 50,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "prompt", "options", "answer", "explanation"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/slug" },
          "type": { "const": "choice" },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 300 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "answer": { "type": "integer", "minimum": 0 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "prompt", "answers", "explanation"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/slug" },
          "type": { "const": "fill-blank" },
          "prompt": { "type": "string", "pattern": "___", "maxLength": 300 },
          "answers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "type": "string", "minLength": 1, "maxLength": 100 }
          },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    ]
  }
}
